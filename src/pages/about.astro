---
import { getEntry, render } from "astro:content";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import AboutIntro from "@components/organisms/AboutIntro.astro";
import AboutLanguages from "@components/organisms/AboutLanguages.astro";
import CommentSection from "@components/organisms/comment/CommentSection.astro";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";
import { url } from "@utils/url-utils";
import { commentConfig, resolveCommentOptions, siteConfig } from "@/config";
import { aboutConfig } from "@/config/aboutConfig";

if (!aboutConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(aboutConfig.title, I18nKey.about);
const pageDescription = resolveI18nText(aboutConfig.description, I18nKey.about);

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content, headings, remarkPluginFrontmatter } = await render(aboutPost);
const markdownStylesheetAssets = await getMarkdownStylesheetAssets(
	remarkPluginFrontmatter.markdownSyntaxes,
);

const aboutCommentEnabled = Boolean(resolveCommentOptions(commentConfig));
const aboutPath = url("about/");
---
<MainGridLayout title={pageTitle} description={pageDescription} headings={headings} page="about" hasComments={aboutCommentEnabled}>
    {markdownStylesheetAssets.map(({ pack, css }) => <style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>)}
    <AboutIntro />
    <AboutLanguages />
    <div class="flex w-full rounded-[var(--shape-corner-l)] overflow-hidden relative min-h-32 mb-4">
        <Card color="var(--card-bg)" radius="l" class="z-10 p-6 lg:p-8 relative w-full">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </Card>
    </div>
    <CommentSection
        context={{
            key: "spec:about",
            path: aboutPath,
            title: pageTitle,
            language: siteConfig.lang,
        }}
        postCommentEnabled={aboutCommentEnabled}
        class="onload-animation"
    />
</MainGridLayout>
