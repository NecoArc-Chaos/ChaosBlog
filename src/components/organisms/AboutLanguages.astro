---
import Card from "@components/atoms/display/Card.svelte";
import SectionTitle from "@components/molecules/SectionTitle.svelte";
import { aboutLanguagesData } from "@/data/about";

interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
---

<section class:list={["about-languages", className]}>
	<Card color="var(--card-bg)" radius="l">
		<div class="about-languages__inner">
			<SectionTitle
				title={aboutLanguagesData.title}
				subtitle={aboutLanguagesData.subtitle}
				icon={aboutLanguagesData.icon}
			/>
			<ul class="about-languages__grid" role="list">
				{aboutLanguagesData.items.map((lang) => (
					<li class="language-card">
						<div class="language-card__header">
							<h3 class="language-card__name">{lang.name}</h3>
							<span class="language-card__level">
								<span class="sr-only">等级: </span>
								{lang.level}
							</span>
						</div>
						<p class="language-card__code">
							<span class="sr-only">语言代码: </span>
							<code>{lang.code}</code>
							{lang.note && <span class="language-card__note">{lang.note}</span>}
						</p>
					</li>
				))}
			</ul>
		</div>
	</Card>
</section>

<style lang="stylus">
@import "../../styles/breakpoints.styl"

.about-languages
	margin-bottom: var(--m3e-space-4)

	&__inner
		padding: var(--m3e-space-4)
		@media (min-width: bp-sm)
			padding: var(--m3e-space-6)

	&__grid
		display: grid
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr))
		gap: var(--m3e-space-3)
		margin: 0
		padding: 0
		list-style: none
		@media (min-width: bp-md)
			grid-template-columns: repeat(3, minmax(0, 1fr))

.language-card
	display: flex
	flex-direction: column
	justify-content: space-between
	gap: var(--m3e-space-2)
	min-width: 0
	padding: var(--m3e-space-3) var(--m3e-space-4)
	background: var(--surface-container)
	border: 1px solid var(--outline-variant)
	border-radius: var(--shape-corner-m)
	transition:
		background-color var(--m3e-duration-short) var(--m3e-easing-standard),
		border-color var(--m3e-duration-short) var(--m3e-easing-standard)
	&:hover
		background: unquote("color-mix(in oklab, var(--secondary) 6%, var(--surface-container))")
		border-color: unquote("color-mix(in oklab, var(--secondary) 40%, var(--outline-variant))")

	&__header
		display: flex
		align-items: center
		justify-content: space-between
		gap: var(--m3e-space-2)
		min-width: 0

	&__name
		margin: 0
		min-width: 0
		color: var(--on-surface)
		font: var(--m3e-type-title-medium)
		font-weight: 600
		overflow-wrap: anywhere

	&__level
		flex-shrink: 0
		padding: 0.125rem 0.625rem
		border-radius: var(--shape-corner-full)
		background: var(--secondary-container)
		color: var(--on-secondary-container)
		font: var(--m3e-type-label-small)
		font-weight: 600
		white-space: nowrap

	&__code
		display: flex
		flex-wrap: wrap
		align-items: center
		gap: var(--m3e-space-2)
		margin: 0
		min-width: 0
		overflow-wrap: anywhere

		code
			display: inline-block
			padding: 0.0625rem 0.375rem
			border-radius: var(--shape-corner-xs)
			background: var(--surface-container-highest)
			color: var(--on-surface-variant)
			font: var(--m3e-type-code)
			font-size: 0.75rem

	&__note
		font: var(--m3e-type-body-small)
		color: var(--on-surface-variant)
</style>
